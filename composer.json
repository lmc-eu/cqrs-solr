{
    "name": "lmc/cqrs-solr",
    "description": "A library containing base implementations to help with Solr Queries and Commands",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "lmc/cqrs-types": "^3.2",
        "nelmio/solarium-bundle": "^5.0",
        "solarium/solarium": "^6.2.3"
    },
    "require-dev": {
        "almacareer/coding-standard": "^4.2",
        "ergebnis/composer-normalize": "^2.5",
        "php-parallel-lint/php-parallel-lint": "^1.2",
        "phpstan/extension-installer": "^1.1",
        "phpstan/phpstan": "^1.4",
        "phpstan/phpstan-phpunit": "^1.0",
        "phpunit/phpunit": "^11.0.4"
    },
    "autoload": {
        "psr-4": {
            "Lmc\\Cqrs\\Solr\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lmc\\Cqrs\\Solr\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "ergebnis/composer-normalize": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "all": [
            "@lint",
            "@analyze",
            "@tests"
        ],
        "analyze": [
            "@cs",
            "@phpstan"
        ],
        "cs": "vendor/bin/ecs check --ansi",
        "fix": [
            "vendor/bin/ecs check --ansi --clear-cache --fix",
            "@composer normalize"
        ],
        "lint": [
            "vendor/bin/parallel-lint -j 10 ./src ./tests",
            "@composer validate",
            "@composer normalize --dry-run"
        ],
        "phpstan": "vendor/bin/phpstan analyze -c phpstan.neon --ansi",
        "tests": "vendor/bin/phpunit",
        "tests-ci": "mkdir -p reports && php -dxdebug.coverage_enable=1 vendor/bin/phpunit -c phpunit.xml.dist"
    }
}
